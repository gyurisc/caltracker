<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.caltrack.server</string>

  <!-- pnpm by absolute path. `zsh -lc` does NOT source .zshrc, which is where
       nvm lives, so a bare `pnpm` here fails with exit 127 and KeepAlive turns
       that into a restart loop. The installer fills both of these in from
       `which pnpm`, so re-run it after a node upgrade.
       caffeinate -s keeps the Mac awake, or polling stops when it sleeps. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>__PNPM__</string>
    <string>start</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODEBIN__:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__ROOT__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart if it exits for any reason, including a crash. -->
  <key>KeepAlive</key>
  <true/>

  <!-- Wait 10s between restarts, so a port clash cannot become a hot loop. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__ROOT__/data/caltrack.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT__/data/caltrack.log</string>
</dict>
</plist>
